{:paths ["src/main/clojure" "src/main/cljs" "resources"]
 :deps
 {com.cognitect/transit-java {:mvn/version "1.0.362"}
  ;; cljf.selfhost reads analysis caches in the page
  com.cognitect/transit-cljs {:mvn/version "0.8.280"}
  org.clojure/clojure {:mvn/version "1.10.0"}
  org.clojure/core.specs.alpha {:mvn/version "0.1.24"}
  org.clojure/google-closure-library {:mvn/version "0.0-20250515-f04e4c0e"}
  org.clojure/spec.alpha {:mvn/version "0.1.143"}
  org.clojure/tools.reader {:mvn/version "1.3.6"}
  org.clojure/test.check {:mvn/version "1.1.1"}}
 :aliases
 {;; the Closure Compiler and the parser of its externs (cljs.externs), for
  ;; script/gen-default-externs only: the compiler doesn't need them
  :closure           {:extra-paths ["script/gen_default_externs"]
                      :extra-deps {com.google.javascript/closure-compiler {:mvn/version "v20250820"}}}
  :compiler.test     {:extra-paths ["src/test/cljs" "src/test/clojure"]
                      :extra-deps {org.clojure/spec.alpha {:mvn/version "0.5.238"}}}
  :compiler.test.run {:main-opts ["-i" "src/test/clojure/cljs/test_runner.clj"
                                  "-e" "(cljs.test-runner/-main)"]}}}
