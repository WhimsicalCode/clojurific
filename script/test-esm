#!/bin/sh

# Runs the analyzer's and the compiler's unit tests (cljs.test-runner), the
# tests of cljf.esm builds and their REPL, with its nREPL server and
# cider-nrepl's middleware, and the runtime test suite compiled to ES modules
# with Node.js, unbundled.

if ! clojure -M:compiler.test:compiler.test.run; then
  >&2 echo analyzer and compiler tests failed
  exit 1
fi

if ! clojure -Sdeps '{:aliases {:esm-build-test {:extra-paths ["src/test/clojure" "src/test/esm_repl"]
                                              :extra-deps {nrepl/nrepl {:mvn/version "1.7.0"}
                                                           cider/cider-nrepl {:mvn/version "0.63.1"}}}}}' \
       -M:esm-build-test -e "(require 'cljf.esm-build-tests 'cljf.esm-repl-tests)
                             (let [{:keys [fail error]} (clojure.test/run-tests 'cljf.esm-build-tests 'cljf.esm-repl-tests)]
                               (System/exit (if (zero? (+ fail error)) 0 1)))"; then
  >&2 echo cljf.esm build tests failed
  exit 1
fi

rm -rf builds/out-esm
mkdir -p builds/out-esm

if ! clojure -Sdeps '{:aliases {:esm-test {:extra-paths ["src/test/cljs" "src/test/esm"]}}}' \
       -M:esm-test -m cljf.esm \
       '{:main esm-test-runner :output-dir "builds/out-esm" :parallel-build true :verbose true}'; then
  >&2 echo ClojureScript compilation failed
  exit 1
fi

node builds/out-esm/esm_test_runner.js | tee builds/out-esm/test.log
grep -q "^0 failures, 0 errors." builds/out-esm/test.log
