#!/bin/sh

# Tests the cljf launcher (src/main/js/cljf, with Node.js' test runner), then
# the npm package: packs it with script/package-npm, installs it into an empty
# project, builds a namespace with npx cljf, and bundles a page loading its
# source, and a JavaScript module importing another, with Vite and the plugin. The package gets the compiler from Clojars:
# the project's local Maven repository has the jar of this version
# (script/clojars install), and downloads the rest (about 20 MB).
# CLJF_TEST_DOWNLOADS=1 also
# tests a start with an empty local Maven repository, see
# src/main/js/cljf/test/launcher.test.js.

set -e
cd "$(dirname "$0")/.."

node --test 'src/main/js/cljf/test/*.test.js'

script/package-npm
version=$(node -p "require('./builds/npm/package.json').version")
project=$(mktemp -d)
trap 'rm -rf "$project"' EXIT
mkdir -p "$project/src/smoke"
script/clojars install "$project/m2"
printf '{:paths ["src"] :mvn/local-repo "%s"}\n' "$project/m2" > "$project/deps.edn"
printf '(ns smoke.core)\n(println "smoke" (+ 1 2))\n' > "$project/src/smoke/core.cljs"
(
  cd "$project"
  npm init -y > /dev/null
  npm pkg set type=module
  npm install --silent --no-audit --no-fund vite@8.2.2 "$OLDPWD/builds/clojurific-$version.tgz"
  npx cljf classpath | tr ':' '\n' | grep -qx "$project/m2/com/whimsical/clojurific/$version/clojurific-$version.jar"
  npx cljf build '{:main smoke.core :output-dir "out"}'
  output=$(node out/smoke/core.js)
  test "$output" = "smoke 3"

  printf '(ns smoke.extra)\n(println "extra")\n' > src/smoke/extra.cljs
  printf 'import "./smoke/extra.cljs";\n' > src/entry.js
  printf '<!doctype html>\n<script type="module" src="/src/smoke/core.cljs"></script>\n<script type="module" src="/src/entry.js"></script>\n' > index.html
  printf '%s\n' "import cljs from 'clojurific/vite';" \
    "export default {" \
    "  plugins: [cljs({ outputDir: 'target/cljs' })]," \
    "  // the polyfill needs a document, the bundle runs in Node.js here" \
    "  build: { modulePreload: { polyfill: false } }," \
    "};" > vite.config.mjs
  npx vite build --logLevel warn
  # the page's scripts, imported in order as a browser runs them, print what
  # the namespaces did
  scripts=$(sed -n 's|.*<script[^>]*src="/\([^"]*\.js\)".*|dist/\1|p' dist/index.html)
  test -n "$scripts"
  output=$(node --input-type=module -e "
    import { pathToFileURL } from 'node:url';
    for (const script of process.argv.slice(1)) await import(pathToFileURL(script).href);" $scripts)
  test "$output" = "$(printf 'smoke 3\nextra')"
)
echo "npm package: ok"
